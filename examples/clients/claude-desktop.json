{
  "mcpServers": {
    "gemini": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Luckycat133/gemini-web-mcp@codex/gemini-tools-polish-20261101",
        "gemini-mcp-function"
      ],
      "env": {
        "GEMINI_PSID": "REPLACE_WITH_SECURE_1PSID",
        "GEMINI_PSIDTS": "REPLACE_OR_REMOVE_IF_UNAVAILABLE",
        "GEMINI_AUTO_REFRESH": "false"
      }
    }
  }
}
