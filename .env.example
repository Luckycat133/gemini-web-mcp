# ── Gemini Web Authentication ──────────────────────────────────────────────────
# Install the browser extra for automatic discovery from an authorized browser.
# Leave secrets empty here; supply them only through your local secret environment.
GEMINI_PSID=
GEMINI_PSIDTS=

# Optional paid Gemini API route for explicit video model gemini-omni-1.2-flash:
# GEMINI_API_KEY=

# Optional cookies / extra cookies appended to client requests:
# GEMINI_PSIDCC=

# Optional:
# GEMINI_PROXY=
# GEMINI_AUTO_REFRESH= (default: true)
# GEMINI_BROWSER_AUTO_LOAD= (default: true; false disables startup discovery)
# Optional shared metadata-only research operation database (seven-day retention):
# GEMINI_OPERATION_DB_PATH=
# Bound each macOS Keychain wait used by browser-cookie3 (0.01-120 seconds):
# GEMINI_BROWSER_COOKIE_TIMEOUT_SECONDS= (default: 15)
# GEMINI_TOOLS= (unset selects the function surface; core is explicit compatibility)
# GEMINI_CHAT_RETENTION_SECONDS= (default: 0)
# Optional durable, account-scoped cleanup queue:
# GEMINI_CLEANUP_DB_PATH=

# skill_server local prompt library directory (contains prompts.json):
# GEMINI_CONFIG_DIR=

# gemini_webapi cookie cache directory; normally managed automatically by
# client_manager when refreshing cookies from a browser:
# GEMINI_COOKIE_PATH=
